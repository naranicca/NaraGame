# Scene editor runtime state written next to the running exe.
# ImGui docking layout + per-machine UI preferences (font scale) +
# always-on file log dumped by Log::Write.
scene-editor.ini
editor.prefs.json
nara-log.txt

# Citybuilder runtime save file (written next to the running exe).
# Packaged demo saves in assets/ are *not* ignored — see demo.save.
citybuilder.save
flappy_high.txt
invaders_save.cfg

# Vendored Lua 5.4 sources (each dev grabs these locally per
# third_party/lua/README.md). Keep the README + this rule tracked.
third_party/lua/*
!third_party/lua/README.md

